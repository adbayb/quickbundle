{
	"name": "root",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "stack build",
		"check": "stack check",
		"clean": "stack clean",
		"fix": "stack fix",
		"install": "stack install && pnpm --filter quickbundle build",
		"release:changelog": "stack release --changelog",
		"release:publish": "stack release --publish",
		"release:snapshot": "stack release --snapshot",
		"release:version": "stack release --bump",
		"start": "stack start",
		"test": "stack test",
		"watch": "stack watch"
	},
	"devDependencies": {
		"@adbayb/stack": "3.4.0",
		"@types/node": "26.6.6"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.0.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26.0.0",
			"onFail": "error"
		}
	}
}
